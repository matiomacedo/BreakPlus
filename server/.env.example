# Copia para .env e preenche (nunca fazer commit do .env)

# MongoDB: tem de ser um replica set (o Atlas já é). Ver server/README.md.
MONGODB_URI=mongodb+srv://UTILIZADOR:PASSWORD@CLUSTER.mongodb.net/breakplus?retryWrites=true&w=majority
PORT=3000

# Caminho para o data.js partilhado (usado pelo seed e pelas regras das reservas)
DATA_JS=../shared/data.js

# Segredo para assinar os tokens de login. OBRIGATÓRIO: o servidor não arranca sem ele.
# Gera um aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=muda-isto

# Chave partilhada com o terminal do bar: o terminal envia-a no cabeçalho X-Terminal-Key.
# OBRIGATÓRIA. Copia o mesmo valor para terminal/config.js. Gera uma aleatória como o JWT_SECRET.
TERMINAL_KEY=muda-isto

# Origens (endereço onde abres as páginas) autorizadas a usar a API, separadas por vírgulas.
# Sem isto, o browser bloqueia os pedidos da app dos alunos e do terminal.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
